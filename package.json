{
  "name": "revido-kit-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "theme": "node scripts/build-theme.mjs",
    "theme:check": "node scripts/build-theme.mjs --check",
    "dev": "node scripts/build-theme.mjs && next dev",
    "build": "node scripts/build-theme.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm theme:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@revido-llc/kit": "0.13.1",
    "lucide-react": "1.54.0",
    "motion": "14.0.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-better-tailwindcss": "4.9.0",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
